{
  "name": "open-ticket",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "AI-powered vintage movie ticket stub generator with a Cloudflare Worker backend.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaleXiao/open-ticket.git"
